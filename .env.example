# Names of the environment variables, with empty values. Copy to .env and fill
# in. Never put a real value in this file: the repository is public.
# The full list, with defaults, is packages/shared/config/settings.py.

# Accounts that bypass the trial and the plan limits (comma-separated e-mail
# addresses). Real personal addresses: set them only in the real environment.
DEVELOPER_EMAILS=

# Public test of the app. EMPTY (the default) = normal behaviour: 14-day trial,
# then a plan. Set to a plan ("plus", "pro" or "ultra") and every account is
# reported on that plan, nobody pays, the trial never ends and choosing a plan
# changes nothing. Only this variable can switch it on, never a request from the
# app. Remove it (or empty it) to end the test: nothing was saved, every account
# is back exactly where it was. Anything that is not a plan is ignored.
SUBSCRIPTION_TEST_PLAN=

# How many pets one owner may keep in Ricordi (owner decision 2026-11-16: pets in
# Ricordi do not count towards the plan's pets). Empty = 30. A whole number above
# zero; anything else is ignored with a warning. The backend writes it into the
# database rule (plan_access_config.max_memorial_pets) and tells the app. The Terms
# state the number ("oggi 30"): tell the legal session BEFORE changing it (a cut needs
# the notice of the Terms, section 13, and only applies to new entries).
MEMORIAL_PETS_MAX=

# Chat model (owner decision 2026-11-07): Claude Haiku 5.5 through the official
# SDK. LLM_PROVIDER=anthropic; the Groq variables stay for the automatic
# reserve, the vision and the dictation. Effort: low, medium or high. The
# other names, with defaults, are in packages/shared/config/settings.py.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
ANTHROPIC_EFFORT_LIGHT=
URGENT_ANSWER_TIMEOUT_SECONDS=
# Daily spending cap of the paid model, in EUROS (default 1.0, never lower in
# production), and the exchange rate it is counted with (USD for 1 EUR,
# default 1.1165). Past the cap the Groq reserve answers until midnight UTC.
LLM_DAILY_BUDGET_EUR=
LLM_USD_PER_EUR=
# The monthly credit of the Anthropic account (USD, default 100): the admin
# portal's AI usage page shows the month's spend against it. Information only.
LLM_MONTHLY_CREDITS_USD=
# Where Claude runs: global (standard price, default) or us (US-only inference,
# 1.1 times the price on every token). The spending cap counts with this value,
# so the client must send the same one as inference_geo.
ANTHROPIC_INFERENCE_GEO=
# Groq (reserve, vision, dictation).
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODELS=
# Chat evaluations (scripts/eval): keys of SEPARATE accounts, never the
# production ones.
EVAL_LLM_API_KEY=
EVAL_ANTHROPIC_API_KEY=

# E-mail sending (docs/auth/02). Off by default: nothing is sent until this is
# true AND the provider below is set. The provider is the owner's choice.
EMAIL_SENDING_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
EMAIL_FROM=

# Around the world (docs/product/18): also show the travel cards still in draft. Development only,
# refused in production: people only ever see approved cards.
TRAVEL_CARDS_INCLUDE_DRAFTS=false
# Quokka trial settings. Native store purchases will be configured separately.
BILLING_ENABLED=false
BILLING_TRIAL_DAYS=14
BILLING_SITE_URL=https://quokkapp.net
# --- Store billing (docs/billing/02_configurazione_store.md). Secrets: only in the
# deployment environment, never in the repository.
# Random 32+ bytes; derives the pseudonymous purchase token. Never rotate after launch.
BILLING_ACCOUNT_TOKEN_SECRET=
# sandbox (dev/TestFlight/internal testing) or production. Never both.
BILLING_STORE_ENVIRONMENT=sandbox
BILLING_VERIFICATION_TOLERANCE_HOURS=24
# Optional JSON override of the product ids (see ProductCatalog).
BILLING_CATALOG_JSON=
# Team test grants via /admin/billing/test-grant (refused in production anyway).
BILLING_ADMIN_TEST_GRANTS=false
# Team/demo accounts on a fixed plan without the store: email:plan,email:plan.
# Real addresses only in the deployment environment. DEVELOPER_EMAILS stays unlimited.
BILLING_PLAN_OVERRIDES=
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# Content of the App Store Connect .p8 key (newlines as \n).
APPLE_PRIVATE_KEY=
# Apple Root CA - G3 (PEM or base64), from apple.com/certificateauthority.
APPLE_ROOT_CERTIFICATES=
GOOGLE_PLAY_PACKAGE_NAME=
# Service account JSON with the Play Console "View financial data / Manage orders" permission.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Pub/Sub push subscription: OIDC audience and the push service account e-mail.
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
