# Names of the environment variables, with empty values. Copy to .env and fill
# in. Never put a real value in this file: the repository is public.
# The full list, with defaults, is packages/shared/config/settings.py.

# Accounts that bypass the trial and the plan limits (comma-separated e-mail
# addresses). Real personal addresses: set them only in the real environment.
DEVELOPER_EMAILS=

# Public test of the app. EMPTY (the default) = normal behaviour: 14-day trial,
# then a plan. Set to a plan ("plus", "pro" or "ultra") and every account is
# reported on that plan, nobody pays, the trial never ends and choosing a plan
# changes nothing. Only this variable can switch it on, never a request from the
# app. Remove it (or empty it) to end the test: nothing was saved, every account
# is back exactly where it was. Anything that is not a plan is ignored.
SUBSCRIPTION_TEST_PLAN=

# Chat model (owner decision 2026-11-07): Claude Haiku 5.5 through the official
# SDK. LLM_PROVIDER=anthropic; the Groq variables stay for the automatic
# reserve, the vision and the dictation. Effort: low, medium or high. The
# other names, with defaults, are in packages/shared/config/settings.py.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
ANTHROPIC_EFFORT_LIGHT=
URGENT_ANSWER_TIMEOUT_SECONDS=
# Daily spending cap of the paid model, in EUROS (default 1.0, never lower in
# production), and the exchange rate it is counted with (USD for 1 EUR,
# default 1.1165). Past the cap the Groq reserve answers until midnight UTC.
LLM_DAILY_BUDGET_EUR=
LLM_USD_PER_EUR=
# Where Claude runs: global (standard price, default) or us (US-only inference,
# 1.1 times the price on every token). The spending cap counts with this value,
# so the client must send the same one as inference_geo.
ANTHROPIC_INFERENCE_GEO=
# Groq (reserve, vision, dictation).
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODELS=
# Chat evaluations (scripts/eval): keys of SEPARATE accounts, never the
# production ones.
EVAL_LLM_API_KEY=
EVAL_ANTHROPIC_API_KEY=
