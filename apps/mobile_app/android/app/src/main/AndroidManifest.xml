<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Release builds need network too; debug/profile manifests used to be the only ones declaring it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime permission on Android 13+ (API 33), requested via
         permission_handler from the first-run notification prompt — see
         lib/features/first_run/presentation/pages/notification_permission_page.dart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets flutter_local_notifications put the scheduled reminder/medicine/
         birthday notifications back after a reboot (lib/features/notifications/).
         Deliberately NO SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM: inexact alarms
         may arrive a few minutes late in Doze, which is fine for these, and
         exact ones need a Google Play declaration reserved to alarm/calendar apps. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Foreground-only location — Località in Impostazioni, passeggiate, attività locali.
         See docs/compliance/05_permessi_dispositivo_os.md. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Keeps GPS tracking alive while a walk is running and the app is
         backgrounded (active_walk_controller.dart's foregroundNotificationConfig)
         via a persistent notification - NOT the same thing as
         ACCESS_BACKGROUND_LOCATION ("Allow all the time"), which
         docs/compliance/05_permessi_dispositivo_os.md explicitly defers
         pending a roadmap decision because of its store-review scrutiny.
         A typed foreground service only needs the app to already hold
         foreground location access, which it does. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Photos and videos go through the system camera and picker (image_picker,
         file_picker), which need no permission. open_filex (PDF viewer) brings in
         media-read permissions through its manifest; they are removed here. -->
    <!-- Android 9 and older only: gal (copy of in-app camera captures into the
         "VetApp" album) needs it there; from Android 10 MediaStore saves our own
         files with no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <application
        android:label="vetapp"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- The home-screen widget's buttons start this Activity with a
                 `homewidget://new_reminder|start_walk?petId=...` data URI.
                 By default Flutter (3.27+) treats any intent data as a
                 deep-link ROUTE: cold start makes it the initial route and a
                 running app gets a pushRouteInformation, which
                 AppRouter.onGenerateRoute answers with a SplashPage - and the
                 splash's pushReplacement then lands on the plain home,
                 swallowing the widget action (owner report, 2026-09-30).
                 The app has no other deep links, and the widget URI is read
                 by the home_widget plugin instead (walk_home_widget.dart),
                 so route handling is switched off. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Delivers the "Passeggiate" home-screen widget's tap-a-pet click
                 to this Activity instead of a fresh one (see walk_home_widget.dart
                 and DogWalksWidgetProvider.kt) - singleTop above means a running
                 instance gets it via onNewIntent rather than being recreated. -->
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.LAUNCH" />
            </intent-filter>
            <!-- Password-recovery link from the Supabase email (redirectTo in
                 supabase_auth_remote_data_source.dart). supabase_flutter reads it
                 via app_links; it's not routed by Flutter (see the meta-data above). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vetapp" android:host="auth-callback" />
            </intent-filter>
        </activity>
        <!-- "Passeggiate" home-screen widget: shows the owner's pets, tapping
             one opens the app straight into a new walk for that pet (owner
             request, 2026-09-29). See DogWalksWidgetProvider.kt and
             res/xml/dog_walks_widget_info.xml. -->
        <receiver
            android:name=".DogWalksWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dog_walks_widget_info" />
        </receiver>
        <!-- flutter_local_notifications: shows the scheduled notifications and
             reschedules them after a reboot or an app update. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
