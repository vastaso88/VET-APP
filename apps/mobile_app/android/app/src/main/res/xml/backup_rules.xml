<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier (Auto Backup). allowBackup="false" already turns
     cloud backup off; these rules are the belt to that suspender: the
     Supabase session, the home address, chat drafts and the pets cache must
     never leave the device through a backup or a device-to-device copy
     (docs/security/02_audit.md, finding app-M1). -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
