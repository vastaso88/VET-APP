<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key><false/>
    <key>NSPrivacyTrackingDomains</key><array/>
    <!-- Native Runner code does not directly use required-reason APIs.
         Plugins supply their own manifests; review the aggregated archive report.
         App data collection is documented separately in App Store Connect. -->
    <key>NSPrivacyAccessedAPITypes</key><array/>
</dict>
</plist>
