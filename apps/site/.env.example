# Dati del titolare per la pubblicazione del sito. SOLO NOMI, mai valori: il repository è pubblico.
#
# I valori si inseriscono su Vercel: Project -> Settings -> Environment Variables,
# ambiente "Production". Il nome della variabile è QUOKKA_SITE_ + il nome del segnaposto
# che compare tra parentesi quadre nei testi (QUOKKA_SITE_TITOLARE riempie [TITOLARE]).
# Ogni valore: una sola riga, senza [ ] | ` * < >.
#
# Se manca una variabile e il segnaposto è ancora nel testo, il deploy di produzione
# FALLISCE e l'ultima versione pubblicata resta online. Le anteprime (altri rami)
# restano in bozza e non hanno bisogno delle variabili.
#
# Il minimo da mostrare è stabilito dalla sessione Normativa: l'elenco sotto è quello
# dei segnaposto presenti oggi nei testi di docs/compliance/it/.

# Ragione sociale
QUOKKA_SITE_TITOLARE=
# Sede legale
QUOKKA_SITE_SEDE=
# Codice fiscale / partita IVA
QUOKKA_SITE_CF_PIVA=
# Ufficio del registro delle imprese e numero REA (art. 2250 c.c.)
QUOKKA_SITE_REA_REGISTRO_IMPRESE_SE_SOCIETA=
# Capitale sociale versato (art. 2250 c.c.), per esempio "10.000 euro"
QUOKKA_SITE_CAPITALE_SOCIALE_VERSATO=
# PEC
QUOKKA_SITE_PEC=
# Responsabile della protezione dei dati (o "non designato")
QUOKKA_SITE_DPO_O_NON_DESIGNATO=
# Data dell'ultimo aggiornamento dei testi
QUOKKA_SITE_DATA=

# FACOLTATIVI (nome che finisce in _O_VUOTO): se la società non ha quella condizione si lasciano
# non impostati e la riga sparisce dal piè di pagina. Il valore porta la sua punteggiatura.
# Socio unico, per esempio "Società con socio unico."
QUOKKA_SITE_SOCIO_UNICO_O_VUOTO=
# Stato di liquidazione, per esempio "Società in liquidazione."
QUOKKA_SITE_LIQUIDAZIONE_O_VUOTO=

# Gli altri segnaposto dei testi (EMAIL_*, PREZZO_*, GARANZIE_*, ...) non sono dati del titolare:
# si risolvono scrivendo il testo definitivo in docs/compliance/it/, non qui.
